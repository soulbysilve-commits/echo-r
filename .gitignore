# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local-only operator packaging output (scripts/package-echo-agent-release.mjs) --
# the deployed app reads release artifacts from R2 at runtime, never from
# these local files; they have no business being part of a deployment.
/release-output

# local-only marker: the revision veritas-release-orchestrator last confirmed
# deployed to Production (OfficialSiteAdapter.getCurrentProduction()) --
# orchestrator bookkeeping, never part of the deployed app itself.
/.veritas-orchestrator-deployed-revision

# typescript
*.tsbuildinfo
next-env.d.ts
